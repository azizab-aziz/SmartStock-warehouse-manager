# Build outputs
bin/
obj/

# Code::Blocks machine-specific files
*.depend
*.layout

# Runtime data - local only, don't commit
saves/*.db
saves/*.db-wal
saves/*.db-shm

# Vendored third-party libraries - downloaded separately by anyone who clones
lib/raylib/*
lib/raygui/*
lib/sqlite3/*
!lib/raylib/.gitkeep
!lib/raygui/.gitkeep
!lib/sqlite3/.gitkeep

# OS junk
Thumbs.db
desktop.ini
